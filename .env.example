# Root environment configuration for docker-compose (NFR-7).
# Never commit real secrets — placeholders only.

# Claude API. CLAUDE_API_KEY is the one variable with no usable default --
# compose fails fast with a readable message if it is unset.
CLAUDE_API_KEY=sk-ant-placeholder-replace-me
CLAUDE_MODEL=claude-opus-4-8

# Database (shared by db + backend services)
DATABASE_URL=postgresql+asyncpg://contextiq:contextiq@db:5432/contextiq
POSTGRES_USER=contextiq
POSTGRES_PASSWORD=contextiq
POSTGRES_DB=contextiq

# Embedding model. Its output dimension must match the `vector(384)` column
# in the ingestion-schema migration (alembic/versions/9c080291f1a0_*.py) --
# a different model means a different dimension and every insert fails.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ingestion chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5
RRF_K=60

# Upload limits (FR-1) and on-disk storage location for uploaded files
MAX_UPLOAD_SIZE_MB=20
STORAGE_DIR=storage

# Frontend API base URL. Empty is correct for docker-compose: the browser
# talks only to the frontend's own origin and nginx proxies /api to the
# backend, so CORS never applies. Set it only when the API is served from a
# different origin — and note Vite inlines it at BUILD time, so a change
# needs `docker compose build frontend`, not just a restart.
VITE_API_BASE_URL=

# Host ports. The frontend defaults to 8080 because binding 80 needs root.
FRONTEND_PORT=8080
BACKEND_PORT=8000
# 5433, because a locally installed Postgres usually already owns 5432.
# Only affects host access (psql); the backend talks to `db:5432` internally.
POSTGRES_PORT=5433
