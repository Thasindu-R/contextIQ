# Frontend environment configuration.
# Copy to .env.local and adjust. Only VITE_-prefixed vars reach the client.

# Base URL of the ContextIQ backend API, with no trailing slash.
#
# Leave empty in development to use Vite's /api dev-server proxy
# (see vite.config.ts), which keeps requests same-origin. Set it to an
# absolute origin (e.g. http://localhost:8000) to bypass the proxy, and
# remember the backend must allow that origin -- see Settings.cors_origins.
VITE_API_BASE_URL=
