# Backend environment configuration (NFR-7: never commit real secrets here).
#
# This file is for running the backend DIRECTLY ON THE HOST -- `uvicorn
# app.main:app`, `pytest`, `alembic upgrade head`. Copy it to backend/.env
# (gitignored) and fill in a real key.
#
# docker compose does NOT read this file. The compose stack takes its
# configuration from the repo-root .env (`cp .env.example .env`), which is
# where the container-side values live. That split is deliberate, and it is
# why the two files disagree about the database host: inside the compose
# network the database answers to `db`, while on the host it is `localhost`.
# Pointing this file at `db:5432` would make every host-run command fail to
# resolve the hostname.

# PostgreSQL connection string (async driver).
# `localhost` -- see the note above. Use a database that already has
# `alembic upgrade head` applied.
DATABASE_URL=postgresql+asyncpg://contextiq:contextiq@localhost:5432/contextiq

# Claude API. Required -- the app cannot generate answers without it.
CLAUDE_API_KEY=sk-ant-placeholder-replace-me
CLAUDE_MODEL=claude-opus-4-8

# Embedding model. Its output dimension must match the `vector(384)` column
# in the ingestion-schema migration (alembic/versions/9c080291f1a0_*.py) --
# a different model means a different dimension and every insert fails.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ingestion chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5
RRF_K=60

# Upload limits (FR-1) and on-disk storage location for uploaded files
MAX_UPLOAD_SIZE_MB=20
STORAGE_DIR=storage
