# Backend environment configuration (NFR-7: never commit real secrets here).

# PostgreSQL connection string (async driver)
DATABASE_URL=postgresql+asyncpg://contextiq:contextiq@db:5432/contextiq

# Claude API
CLAUDE_API_KEY=sk-ant-placeholder-replace-me

# Embedding model (must match pgvector column dimension in db/init.sql)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Ingestion chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5
RRF_K=60
